{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadAgentBarrier": {
      "properties": {
        "held": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "remaining": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "total": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "unavailable": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "held",
        "remaining",
        "total",
        "unavailable"
      ],
      "type": "object"
    },
    "ThreadAgentWork": {
      "description": "Authoritative native-agent mailbox and barrier state, independent of turn activity.",
      "properties": {
        "pendingMail": {
          "description": "Accepted messages not yet included in an accepted model request.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "revision": {
          "description": "Monotonic revision within the current controller instance.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "waitingTasks": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadAgentBarrier"
            },
            {
              "type": "null"
            }
          ],
          "description": "The current wait-all observation, if any. This does not own or cancel tasks."
        }
      },
      "required": [
        "pendingMail",
        "revision"
      ],
      "type": "object"
    }
  },
  "properties": {
    "agentWork": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadAgentWork"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null means this controller cannot currently supply an authoritative snapshot."
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadAgentWorkUpdatedNotification",
  "type": "object"
}